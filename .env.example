# Server-only values. Configure in Vercel Preview and Production separately.
# Never prefix these with VITE_ or commit populated .env files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret of at least 32 characters; hashes IP-derived rate-limit keys.
ENQUIRY_RATE_LIMIT_SALT=
RESEND_API_KEY=
# Real approved recipient, and a Resend-verified sending identity.
ENQUIRY_NOTIFICATION_TO=
ENQUIRY_NOTIFICATION_FROM=
# Comma-separated full origins, with no trailing slash. VERCEL_URL and
# VERCEL_BRANCH_URL preview origins are allowed automatically by the handler.
ENQUIRY_ALLOWED_ORIGINS=
# Protects GET /api/enquiries?action=retry; set only if enabling outbox retries.
ENQUIRY_CRON_SECRET=

# Public optional integrations. Leave blank until the business details are approved.
VITE_WHATSAPP_NUMBER=
VITE_BOOKING_URL=
VITE_GA4_MEASUREMENT_ID=
# Verified production origin only, e.g. https://your-approved-domain.example
# Production indexing requires both SITE_URL and VERCEL_ENV=production.
SITE_URL=
